# Copy to `.env` in this directory (optional; defaults match the order MCP server).

# MCP_SERVER_URL=https://order-mcp-74afyau24q-uc.a.run.app/mcp
# MCP_SERVER_HEADERS={"Authorization":"Bearer <token>"}
# Header values must be HTTP-safe (ASCII / latin-1). Do not use Unicode ellipsis (…) in placeholders.

# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# LOG_LEVEL=INFO
# LOG_JSON=false

# RATE_LIMIT_DEFAULT=120/minute
# REQUEST_ID_HEADER=X-Request-ID

# Chat (SSE). Session JSON files live under CHAT_SESSIONS_DIR (relative to process cwd unless absolute).
# OPENAI_API_KEY=
# OPENAI_API_KEY_SECRET_ARN=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CHAT_SESSIONS_DIR=data/chat_sessions
# CHAT_SESSIONS_S3_BUCKET=
# CHAT_SESSIONS_S3_PREFIX=sessions
